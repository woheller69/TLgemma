<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        tools:context="com.seemless.MainActivity">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Language Selection Row -->
            <LinearLayout
                android:id="@+id/langRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentTop="true">

                <!-- Source Language -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Source"
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerSource"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@android:drawable/btn_dropdown" />

                    <EditText
                        android:id="@+id/etvCustomSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. de-DE"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:inputType="text" />
                </LinearLayout>

                <!-- Swap Button -->
                <ImageButton
                    android:id="@+id/btnSwap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="5dp"
                    android:layout_gravity="bottom"
                    android:textColor="@color/white"
                    android:background="@null"
                    android:src="@drawable/swap_32dp"/>

                <!-- Target Language -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Target"
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerTarget"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@android:drawable/btn_dropdown" />

                    <EditText
                        android:id="@+id/etvCustomTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. de-DE"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:inputType="text" />
                </LinearLayout>

            </LinearLayout>

            <!-- Input Area -->
            <ScrollView
                android:id="@+id/scroll_input"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_below="@id/langRow">

                <EditText
                    android:id="@+id/etvInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:textSize="17sp"
                    android:hint="Enter text to translate…" />
            </ScrollView>

            <!-- Output Area -->
            <ScrollView
                android:id="@+id/scroll_output"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_below="@id/scroll_input">

                <EditText
                    android:id="@+id/etvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:textSize="17sp"
                    android:textIsSelectable="true"
                    android:hint="Translation…" />
            </ScrollView>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@id/translateButton"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <!-- Translate Button -->
            <ImageButton
                android:id="@+id/translateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/translate_48dp"
                android:background="@drawable/rounded_button"
                android:layout_centerHorizontal="true"
                android:layout_below="@id/scroll_output" />

        </RelativeLayout>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
